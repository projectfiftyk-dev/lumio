{
  "info": {
    "name": "Lumio API",
    "description": "Paths, Modules, Books & Media — v0.3",
    "_postman_id": "lumio-api-v0.3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "pathId",
      "value": "",
      "type": "string",
      "description": "Set automatically by the Create Path request"
    },
    {
      "key": "moduleId",
      "value": "",
      "type": "string",
      "description": "Set automatically by the Create Module request"
    },
    {
      "key": "thumbnailKey",
      "value": "",
      "type": "string",
      "description": "Set automatically by the Upload Thumbnail request. Pass as `thumbnail` in create/update bodies."
    },
    {
      "key": "bookId",
      "value": "",
      "type": "string",
      "description": "Set automatically by the Create Book or Upload Confirm request."
    },
    {
      "key": "yamlKey",
      "value": "",
      "type": "string",
      "description": "Set automatically by the Upload Confirm request. The MinIO object key for the uploaded YAML."
    }
  ],
  "item": [
    {
      "name": "Media",
      "item": [
        {
          "name": "Upload thumbnail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('thumbnailKey', body.key);",
                  "    pm.test('thumbnailKey saved', () => pm.expect(body.key).to.be.a('string'));",
                  "    pm.test('url is a presigned MinIO URL', () => pm.expect(body.url).to.include('X-Amz-Signature'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "Image file to upload (jpg, png, webp, gif). Max 100 MB.",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/media/upload",
              "host": ["{{baseUrl}}"],
              "path": ["media", "upload"]
            },
            "description": "Uploads an image to MinIO (private bucket).\n\nReturns:\n- `key` — the stable object key stored in the DB (e.g. `thumbnails/uuid.jpg`). Save this and pass it as the `thumbnail` field when creating or updating a path or module.\n- `url` — a presigned GET URL valid for 7 days. Use this to preview the image immediately after upload.\n\nOnly `image/*` content types are accepted. Files over 100 MB return 413."
          },
          "response": []
        },
        {
          "name": "Upload thumbnail — wrong content type",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "Upload a non-image file (e.g. a .txt or .pdf) to trigger the 400 error.",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/media/upload",
              "host": ["{{baseUrl}}"],
              "path": ["media", "upload"]
            },
            "description": "Uploading a non-image file (e.g. .txt, .pdf) should return 400 Bad Request."
          },
          "response": []
        }
      ]
    },
